# 数据库连接（容器内部用容器名互访）
# 服务器上 MySQL 容器的名字是 mysql_server；如果它不在 app_net 里，改用 host.docker.internal
DB_HOST=mysql_server
DB_PORT=3306
DB_USER=attendance
DB_PASSWORD=改成你的密码
DB_NAME=attendance

# 本地开发时可以改用内存库，不需要 MySQL：DB_DRIVER=memory
DB_DRIVER=mysql

# Cookie 签名密钥，随便一串长随机字符串，改了所有人需要重新登录
APP_SECRET=改成你的随机字符串

# 两位家长的登录口令
CODE_MOM=改成妈妈的口令
CODE_DAD=改成爸爸的口令

PORT=3000
TZ=Asia/Shanghai

# 构建时用得到，可选：国内拉不到 Docker Hub 或 npm 太慢时打开
# BASE_IMAGE=docker.nju.edu.cn/library/node:24-alpine
# NPM_REGISTRY=https://registry.npmmirror.com
